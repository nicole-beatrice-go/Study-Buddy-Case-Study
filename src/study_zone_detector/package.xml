<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>study_zone_detector</name>
  <version>0.0.0</version>
  <description>Study Buddy Pupper: CV person-presence detector. Subscribes to the OAK-D camera topic, detects whether a person is in the frame, and publishes presence state for the behavior controller (study_buddy_fsm).</description>
  <maintainer email="j9yin@ucsd.edu">Juan Yin</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <!-- CV libs (cv2, mediapipe) are pip-installed, not rosdep packages. -->
  <!--   pip install opencv-python mediapipe   (mediapipe only for 'pose' backend) -->


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
